{
  "name": "@vue-termui/example-music-player",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": "dist/main.js",
  "scripts": {
    "auth": "node scripts/auth.mjs",
    "dev": "NODE_OPTIONS='--experimental-ffi --disable-warning=ExperimentalWarning' vite",
    "build": "vite build",
    "start": "node --experimental-ffi --disable-warning=ExperimentalWarning dist/main.js",
    "play": "pnpm run build && pnpm run start",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue-termui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": ">=26.3.0"
  }
}
